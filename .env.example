# Copy this file to .env (the server loads .env automatically). Never put real keys in .env.example: it is a template.
PORT=3000
HOST=127.0.0.1
DB_FILE=./voltai.db

# VoltAI model: gemini (Google AI Studio key), anthropic, or leave the key empty for the built-in offline assistant.
AI_PROVIDER=gemini
GEMINI_API_KEY=
AI_MODEL=gemini-3.5-flash-lite
# Used automatically if the model above is refused.
AI_FALLBACK_MODEL=gemini-3.1-flash-lite
# Hard caps: model requests per day for the whole store, and messages per shopper per day.
AI_DAILY_LIMIT=200
AI_USER_DAILY=25
# Anthropic alternative: AI_PROVIDER=anthropic, ANTHROPIC_API_KEY=..., AI_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=

# Admin account created on first start. Use a long password; a weak one is refused unless HOST is 127.0.0.1.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
# Optional: exact browser origin allowed for cross-origin API access. Leave empty for same-origin use.
ALLOWED_ORIGIN=